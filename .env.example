# Local mock vendor-risk service (started by run_local.py)
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider: Groq (https://console.groq.com). The app calls Groq's
# OpenAI-compatible HTTP API directly, so no provider SDK is required.
GROQ_API_KEY=

# Optional: override the model. Both architectures use the same model.
# Evaluated: openai/gpt-oss-20b (default, full 26-case run), openai/gpt-oss-120b (7-case replicate).
# Also works: qwen/qwen3.8-27b (used in development).
# MODEL_NAME=openai/gpt-oss-20b

# Optional: set to 0 to stop the app from auto-starting the bundled mock API
# when VENDOR_RISK_BASE_URL points at localhost and nothing is listening.
# VENDOR_RISK_AUTOSTART=1
